# haiku-app.env — what the haiku-* release tools need to know about this app.
# Shell syntax: sourced by packaging/*.sh, the CI workflow and the
# haiku-release scripts. Keep values quoted; no spaces around '='.

# ── Identity ──
APP_NAME="Sheath"
APP_CMD="sheath"
APP_SIG="application/x-vnd.Sheath"
RDEF="src/ui/Sheath.rdef"

# ── Version (also in the .rdef app_version and packaging/debian/changelog) ──
VERSION="0.1.0"
REVISION="1"

# ── Package metadata ──
SUMMARY="Bible reader built on the SWORD library"
DESCRIPTION_FILE="packaging/description.txt"
HOMEPAGE="https://github.com/idumych/sheath"
GITHUB_REPO="idumych/sheath"
LICENSE_NAME="GNU GPL v3"
COPYRIGHT="2026 the Sheath contributors"
PACKAGER="Ian <idumych@gmail.com>"

# Extra runtime dependencies beyond the Haiku API itself
HPKG_REQUIRES_EXTRA="lib:libsword_1.8.1"
DEB_DEPENDS_EXTRA="libsword1.9.0t64"
DEB_SECTION="text"
DESKTOP_CATEGORIES="Education;"
APPIMAGE_MUST_BUNDLE="libsword"
APPIMAGE_FONTS_EXTRA="NotoSerif-Regular NotoSerif-Bold NotoSerif-Italic NotoSerif-BoldItalic"
APPIMAGE_APT_EXTRA="libsword-dev fonts-noto-core diatheke unzip"
DEB_APT_EXTRA="libsword-dev"

# ── Build ──
HPKG_BUILD_DEPS="sword_devel"
TEST_CMD="make test"
TYPECHECK_SRCS="src/ui/App.cpp src/ui/ReaderWindow.cpp src/ui/ChapterView.cpp src/ui/EntryWindow.cpp src/ui/SearchWindow.cpp src/ui/InstallWindow.cpp"
TYPECHECK_INCLUDES="src/core src/ui"

# ── Feature test (the app-specific part of release/test-plan.md) ──
FEATURE_CHECKS="install-module read-chapter strongs-lookup search bookmark"
EVIDENCE_1="{p}-read.txt|For God so loved the world"
EVIDENCE_2="{p}-strongs.txt|agapao"
EVIDENCE_3="{p}-search.txt|6 verses"
