resource app_signature "application/x-vnd.Sheath";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Sheath",
	long_info = "Sheath 0.1.0, a Bible reader built on SWORD"
};

resource file_types message {
	"types" = "application/x-vnd.Sheath"
};
